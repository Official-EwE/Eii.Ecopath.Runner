@EwERunApi_HostAddress = http://localhost:5013

GET {{EwERunApi_HostAddress}}/weatherforecast/
Accept: application/json

###

POST {{EwERunApi_HostAddress}}/eweRun?inputFolder=Testdata\AnchovyBay&outputFolder=Testoutput\AnchovyBay
Content-Type: application/json

{
    "Configuration": {
        "ModelFile": "AnchovyBay.eiixml",
        "EcosimScenario": 1,
        "EcosimTimeseries": 0,
        "EcospaceScenario": 1,
        "SaveWithHeader": true,
        "ExtDataConfigFile": "AnchovyBay_extdata.xml",
        "RunYears": 50
    },
    "EcospaceRun": {
        "RunSpinupYears": 10,
        "UseIBM": true,
        "SaveFirstYear": 2005,
        "SaveAnnual": true,
        "SaveContentAsc": [ "biomass", "catch", "effort" ],
        "SaveContentCsv": [ "xyz" ],
        "Changes": [
            {
                "Date": "start",
                "Modifications": {
                    "ecospace.mpa[1].map.fill": 0
                }
            },
            {
                "Date": "1-1-2025",
                "Modifications": {
                    "ecospace.mpa[1].map.load": "mpa_test.asc"
                }
            }
        ]
    }
}

###
