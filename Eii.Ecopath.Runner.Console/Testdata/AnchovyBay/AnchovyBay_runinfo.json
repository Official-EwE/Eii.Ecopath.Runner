{
  "Configuration": {
    "ModelFile": "Anchovy Bay.eiixml",
    "EcosimScenario": 1,
    "EcosimTimeseries": 0,
    "EcospaceScenario": 1,
    "SaveWithHeader": true,
    "ExtDataConfigFile": "drivers_anchbay.xml",
    "RunYears": 50
  },
  "EcosimRun": {
    "SaveContentCSV": [ "biomass", "catch" ],
    "SaveAnnual": false,
    "Changes": [
      {
        "Date": "start",
        "Modifications": {
          "ecosim.effort[trawlers].fill": [ 1 ],
          "ecosim.vulnerabilities.load": "Anchovy Bay-Vulnerabilities_02.csv"
        }
      }
    ]
  },
  "EcospaceRun": {
    "RunSpinupYears": 10,
    "UseIBM": true,
    "SaveFirstYear": 2005,
    "SaveAnnual": true,
    "SaveContentAsc": [ "biomass", "catch", "effort" ],
    "SaveContentCsv": [ "xyz" ],
    "Changes": [
      {
        "Date": "start",
        "Modifications": {
          "ecospace.mpa[MPA 1].map.fill": 0
        }
      },
      {
        "Date": "1-1-2025",
        "Modifications": {
          "ecospace.mpa[MPA 1].map.load": "mpa_test.asc"
        }
      }
    ]
  }
}